#!/usr/bin/env bash
# checks — the AGENTS.md pre-commit checklist, run in the current directory.
#
# Shared by script/pre-commit and script/pre-push. Runs against whatever tree
# the caller has checked out, so pre-push can call it from temporary checkouts.
# Call it from the workspace root.
#
#   script/checks                          everything CI runs
#   script/checks --quick [PATH...]        pre-commit's run
#
# --quick runs the tests of nextest's `quick` profile, which leaves out the slow
# repository, scrolling and highlighter tests, and skips `cargo build`: nextest builds what the
# tests need and clippy checks every target. Given the changed PATHs, relative to
# the workspace root, it also runs only the tests of the changed crates and the crates that
# depend on them, `cargo deny` only when a manifest or the lock file changed, and
# gpui-base's own tests only when vendor/gpui-base changed, script/test-pre-push only
# when script/pre-push or that test changed, script/test-agent-pre-push-hook only when
# script/agent-pre-push-hook or that test changed, script/test-tip only when script/build-id,
# script/pre-push or that test changed, and script/test-jj-repos only when script/gen-jj-repo,
# that test or the directory demo it builds from changed. A change to a vendored crate
# also runs the tests of the workspace crates that depend on the crate it reaches the
# workspace through, and of their dependents: gpui-kit for gpui-base, jj-lib for
# jj-local-util. A change to docs/ or to a Markdown file
# at the root runs no tests. Any other changed path outside crates/ runs every test.
# Build and clippy always cover the workspace, so the feature set, and with it the
# build cache, stays the same for every run.

set -euo pipefail

# Each test run's limit: its time on a warm build (DESIGN.md §A13.5) plus nextest's 30 s
# per-test cap (.config/nextest.toml), so nextest names a hung test before the run is stopped.
readonly QUICK_TEST_TIMEOUT_SECONDS=45
readonly FULL_TEST_TIMEOUT_SECONDS=60

quick=false
if [[ "${1:-}" == --quick ]]; then
    quick=true
    shift
elif [[ $# -gt 0 ]]; then
    echo "usage: script/checks [--quick [PATH...]]" >&2
    exit 2
fi
changed=("$@")

run() {
    echo "==> $*"
    "$@"
}

# gtimeout on macOS (coreutils), timeout on Linux.
timeout_cmd="$(command -v gtimeout || command -v timeout || true)"
test_timeout="${FULL_TEST_TIMEOUT_SECONDS}"
[[ "${quick}" == true ]] && test_timeout="${QUICK_TEST_TIMEOUT_SECONDS}"
if [[ -n "${timeout_cmd}" ]]; then
    test_prefix=("${timeout_cmd}" "${test_timeout}")
else
    test_prefix=()
fi

# Every check runs unless the changed paths say otherwise.
all_tests=true
deny=true
gpui_base_tests=true
pre_push=true
agent_hook=true
tip=true
jj_repos=true
crate_dirs=()
# The crates through which a changed vendored crate reaches the workspace.
vendor_entries=()
if [[ "${quick}" == true && ${#changed[@]} -gt 0 ]]; then
    all_tests=false
    deny=false
    gpui_base_tests=false
    pre_push=false
    agent_hook=false
    tip=false
    jj_repos=false
    for path in "${changed[@]}"; do
        case "${path}" in
            crates/*/Cargo.toml)
                deny=true
                crate_dirs+=("${path%/Cargo.toml}")
                ;;
            crates/*/*) crate_dirs+=("$(cut -d/ -f1-2 <<< "${path}")") ;;
            vendor/gpui-base/*)
                gpui_base_tests=true
                vendor_entries+=(gpui-kit)
                ;;
            vendor/jj-local-util/*) vendor_entries+=(jj-lib) ;;
            docs/*) ;;
            script/pre-push)
                pre_push=true
                tip=true
                all_tests=true
                ;;
            script/test-pre-push)
                pre_push=true
                all_tests=true
                ;;
            script/agent-pre-push-hook | script/test-agent-pre-push-hook)
                agent_hook=true
                all_tests=true
                ;;
            script/build-id | script/test-tip)
                tip=true
                all_tests=true
                ;;
            script/gen-jj-repo | script/test-jj-repos | fixtures/demo/dirs/*)
                jj_repos=true
                all_tests=true
                ;;
            */*) all_tests=true ;;
            # Top-level Markdown: README.md, AGENTS.md.
            *.md) ;;
            Cargo.toml | Cargo.lock | deny.toml)
                deny=true
                all_tests=true
                ;;
            *) all_tests=true ;;
        esac
    done
fi

# The nextest filter for the changed crates and every workspace crate that depends on
# them, directly or not. The crates that depend on one of vendor_entries count
# as changed.
affected_filter() {
    local metadata
    metadata="$(cargo metadata --format-version 1 --no-deps --locked)"
    local root
    root="$(pwd -P)"
    local names=()
    local dir
    for dir in "$@"; do
        names+=("$(jq -r --arg m "${root}/${dir}/Cargo.toml" \
            '.packages[] | select(.manifest_path == $m) | .name' <<< "${metadata}")")
    done
    local entry
    for entry in ${vendor_entries[@]+"${vendor_entries[@]}"}; do
        while IFS= read -r name; do names+=("${name}"); done < <(jq -r --arg e "${entry}" \
            '.packages[] | select(any(.dependencies[]; .name == $e)) | .name' <<< "${metadata}")
    done
    jq -r --args '
        [.packages[] | {name, deps: [.dependencies[].name]}] as $graph
        | def dependents($set):
            ($set + [$graph[] | select(any(.deps[]; IN($set[]))) | .name] | unique) as $next
            | if $next == $set then $set else dependents($next) end;
        dependents($ARGS.positional | map(select(. != "")) | unique)
        | map("package(\(.))") | join(" | ")
    ' ${names[@]+"${names[@]}"} <<< "${metadata}"
}

profile=default
[[ "${quick}" == true ]] && profile=quick
test_args=(--workspace --profile "${profile}")
run_tests=true
if [[ "${all_tests}" != true ]]; then
    filter="$(affected_filter ${crate_dirs[@]+"${crate_dirs[@]}"})"
    if [[ -n "${filter}" ]]; then
        test_args+=(-E "${filter}")
    else
        run_tests=false
    fi
fi

run cargo fmt --all --check
run script/check-workspace
[[ "${quick}" == true ]] || run cargo build --workspace --all-targets
run cargo clippy --workspace --all-targets -- -D warnings
# Built outside the timeout, which is for hung tests: a cold build takes minutes.
if [[ "${run_tests}" == true ]]; then
    run cargo nextest run --workspace --no-run
    run ${test_prefix[@]+"${test_prefix[@]}"} cargo nextest run "${test_args[@]}"
fi
# nextest cannot run doctests. They pin the newtypes; a swap needs a signature change, which the
# full run before each push catches.
[[ "${quick}" == true ]] || run ${test_prefix[@]+"${test_prefix[@]}"} cargo test --doc --workspace
[[ "${deny}" == true ]] && run cargo deny check
[[ "${pre_push}" == true ]] && run script/test-pre-push
[[ "${agent_hook}" == true ]] && run script/test-agent-pre-push-hook
[[ "${tip}" == true ]] && run script/test-tip
# Runs the binary that the build, or nextest's build of the integration tests, leaves.
[[ "${jj_repos}" == true ]] && run script/test-jj-repos
# gpui-base sits outside the workspace; its own unit tests cover the patch.
# Built outside the timeout, as the workspace's tests are.
if [[ "${gpui_base_tests}" == true ]]; then
    gpui_base_tests_args=(--manifest-path vendor/gpui-base/Cargo.toml --features test-support --lib)
    run env CARGO_TARGET_DIR=target/vendor cargo nextest run "${gpui_base_tests_args[@]}" --no-run
    run ${test_prefix[@]+"${test_prefix[@]}"} env CARGO_TARGET_DIR=target/vendor \
        cargo nextest run "${gpui_base_tests_args[@]}"
fi
