#!/usr/bin/env bash
# test-jj-repos — build each script/gen-jj-repo scenario and check triad's jj-enabled commands
# in it through the built binary, end to end: `stack --list`, `resolve -r` with a dry run and
# a write, a save of a three-sided conflict, `history --list`, `absorb --list` and
# `--apply`, and the changed files of `diff --inspect`, natively and from `jj diff --tool`. Expected output comes from each scenario's design (docs/test-repos.md);
# jj's CLI reads back what triad wrote. Change and commit IDs come from jj, by bookmark.
#
# Needs the pinned jj on PATH and a built binary: `cargo build --workspace` first.
#
# Usage: script/test-jj-repos [scenario...]   (default: every scenario)
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
TRIAD="$ROOT/target/debug/triad-merge"
# triad prints IDs at this length (`vcs::ChangeInfo`).
SHORT_ID=8
EXIT_CONFLICTS=1

[[ -x "$TRIAD" ]] || { echo "error: $TRIAD missing; run cargo build --workspace" >&2; exit 2; }
# The checks compare triad with jj's CLI, so jj must be the release jj-lib is pinned to.
pinned=$(sed -n 's/^jj-lib = { version = "=\([^"]*\)".*/\1/p' "$ROOT/Cargo.toml")
found=$(jj --version 2>/dev/null | awk '{print $2}') || true
if [[ -z "$pinned" || "$found" != "$pinned" ]]; then
  echo "error: jj on PATH is '${found:-missing}'; the pinned jj-lib is '${pinned:-unknown}'" >&2
  exit 2
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/triad-test-jj-repos.XXXXXX")
config="$work/jj-config.toml"
trap 'rm -rf "$work"' EXIT
# Exiting from a signal trap runs the EXIT trap; dying from the signal does not.
readonly SIGNAL_EXIT_BASE=128
readonly SIGHUP_NUMBER=1 SIGINT_NUMBER=2 SIGTERM_NUMBER=15
trap 'exit $((SIGNAL_EXIT_BASE + SIGHUP_NUMBER))' HUP
trap 'exit $((SIGNAL_EXIT_BASE + SIGINT_NUMBER))' INT
trap 'exit $((SIGNAL_EXIT_BASE + SIGTERM_NUMBER))' TERM
cat >"$config" <<'EOF'
[user]
name = "triad Fixture"
email = "fixture@example.invalid"
[ui]
paginate = "never"
color = "never"
EOF
# Both jj and triad read this config alone, so the user's jj config cannot change a result.
export JJ_CONFIG="$config"
# triad reads no settings file and logs into the work directory, so the user's settings
# cannot change a result and the user's cache stays untouched.
export TRIAD_CONFIG="$work/no-config.triad"
export TRIAD_LOG_DIR="$work/logs"

failures=0
repo=
fail() { printf 'FAIL %s: %s\n' "$current" "$*"; failures=$((failures + 1)); }
# Compare WANT with GOT, naming WHAT on a mismatch.
same() {
  local what=$1 want=$2 got=$3
  [[ "$want" == "$got" ]] && return 0
  fail "$what"
  diff <(printf '%s\n' "$want") <(printf '%s\n' "$got") | sed 's/^/    /' || true
}
jjr() { (cd "$repo" && jj --quiet "$@"); }
change() { jjr log --no-graph -r "$1" -T "change_id.short($SHORT_ID)"; }
commit() { jjr log --no-graph -r "$1" -T "commit_id.short($SHORT_ID)"; }
conflicts() { { jjr resolve --list -r "$1" 2>/dev/null || true; } | awk '{print $1}' | sort | paste -sd, -; }
# The descriptions of the operations after operation $1, newest first, snapshots left out.
ops_since() {
  jjr op log --no-graph -T 'id.short() ++ " " ++ description.first_line() ++ "\n"' |
    awk -v stop="$1" '$1 == stop { exit } { $1 = ""; sub(/^ /, ""); print }' | grep -v '^snapshot working copy$' || true
}
# Run triad in the repository; sets `out` and `code`.
triad() { code=0; out=$(cd "$repo" && "$TRIAD" "$@" 2>&1) || code=$?; }
build() { repo="$work/$1"; "$ROOT/script/gen-jj-repo" "$1" "$repo" >/dev/null; }

test_stack() {
  build stack
  local s1 s2 s3 wc
  s1=$(change stack-1) s2=$(change stack-2) s3=$(change stack-3) wc=$(change @)

  triad stack --list
  same "stack --list exit" "$EXIT_CONFLICTS" "$code"
  same "stack --list" "$wc $(commit @)
  a.txt (inherited)
  b.txt (inherited)
$s3 $(commit stack-3) stack 3: change b5
  a.txt (inherited)
  b.txt
$s2 $(commit stack-2) stack 2: change c2
  a.txt (inherited)
$s1 $(commit stack-1) stack 1: change a3
  a.txt" "$out"

  # a.txt's regions: a1–a2 unchanged, the a3 conflict, a4–a8 unchanged. Pick left in region 1.
  local pick="$work/pick-left.jsonl"
  echo '{"Toggle":{"region":1,"source":{"Side":0}}}' >"$pick"
  local before
  before=$(jjr op log --no-graph -n 1 -T 'id.short()')
  triad resolve a.txt -r stack-1 --headless --dry-run --commands "$pick"
  same "resolve -r --dry-run exit" 0 "$code"
  same "resolve -r --dry-run" "would resolve a.txt in $s1
  $s2: a.txt -> none
  $s3: a.txt, b.txt -> b.txt
  $wc: a.txt, b.txt -> b.txt" "$out"
  same "conflicts in stack-1 after the dry run" "a.txt" "$(conflicts stack-1)"

  triad resolve a.txt -r stack-1 --headless --commands "$pick"
  same "resolve -r exit" 0 "$code"
  same "resolve -r" "resolved a.txt in $s1
  $s2: a.txt -> none
  $s3: a.txt, b.txt -> b.txt
  $wc: a.txt, b.txt -> b.txt" "$out"
  same "stack-1 conflicts after the write" "" "$(conflicts stack-1)"
  same "stack-2 conflicts after the write" "" "$(conflicts stack-2)"
  same "stack-3 conflicts after the write" "b.txt" "$(conflicts stack-3)"
  same "@ conflicts after the write" "b.txt" "$(conflicts @)"
  same "stack-1's a.txt" "a1 a2 a3 left a4 a5 a6 a7 a8" "$(jjr file show -r stack-1 a.txt | paste -sd' ' -)"
  same "@'s change after the write" "$wc" "$(change @)"
  same "visible heads" 1 "$(jjr log --no-graph -r 'heads(all())' -T '"x\n"' | wc -l | tr -d ' ')"
  # Spec §7.5.1: a write into a commit is one operation, `resolve PATH in CHANGE in triad`.
  same "operations after $before" "resolve a.txt in $s1 in triad" "$(ops_since "$before")"
}

test_sides() {
  build sides
  local wc_commit before
  wc_commit=$(jjr log --no-graph -r @ -T commit_id)
  before=$(jjr op log --no-graph -n 1 -T 'id.short()')
  triad resolve s.txt --headless
  same "resolve --headless exit" "$EXIT_CONFLICTS" "$code"
  # Spec §4.4: more than two sides render in jj's snapshot style, sides and bases in turn.
  same "s.txt markers, labels dropped" "s1
<<<<<<<
+++++++
s2 one
-------
s2
+++++++
s2 two
-------
s2
+++++++
s2 three
>>>>>>>
s3
s4
s5
s6
<<<<<<<
+++++++
s7 one
-------
s7
+++++++
s7 two
-------
s7
+++++++
s7
>>>>>>>
s8
s9" "$(sed -E 's/^([<>+-]{7}) .*/\1/' "$repo/s.txt")"
  # jj reads the save back as the same conflict, so @ keeps its commit.
  same "@ after the save" "$wc_commit" "$(jjr log --no-graph -r @ -T commit_id)"
  # Spec §7.4: a save that reads back as the conflict jj holds writes no operation.
  same "operations after the save" "" "$(ops_since "$before")"
  same "jj resolve --list" "s.txt    3-sided conflict" "$(jjr resolve --list)"
}

test_history() {
  build history
  triad history notes.txt --list
  same "history --list exit" 0 "$code"
  # Newest first: the conflicted merge, the sibling's text, v1 again as @ moved onto one,
  # v4, the deletion, v3, v2, v1 and the empty start.
  same "history --list descriptions" "new empty commit (conflict)
snapshot working copy
new empty commit
snapshot working copy
snapshot working copy (absent)
snapshot working copy
snapshot working copy
snapshot working copy
add workspace 'default' (absent)" "$(cut -d' ' -f3- <<<"$out")"
  local want=(conflict other v1 v4 absent v3 v2 v1 absent) i=0 op text
  while read -r op _; do
    if text=$(jjr --at-op "$op" file show -r @ notes.txt 2>/dev/null); then
      grep -q '^<<<<<<<' <<<"$text" && text=conflict || text=$(tail -n 1 <<<"$text")
    else
      text=absent
    fi
    same "notes.txt at operation $op" "${want[$i]}" "$text"
    i=$((i + 1))
  done <<<"$out"
}

test_absorb() {
  build absorb
  local a b c
  a="$(change A) $(commit A)" b="$(change B) $(commit B)" c=$(change C)
  local hunks="1 f.txt left 0..1 right 0..1 stays: no one commit in --into wrote its lines
2 f.txt left 2..3 right 2..3 -> $a
3 f.txt left 5..6 right 5..6 -> $a
4 f.txt left 8..9 right 8..9 -> $b
5 f.txt left 11..12 right 11..12 stays: would conflict in $(change A)"

  triad absorb --list
  same "absorb --list exit" 0 "$code"
  same "absorb --list" "at operation $(jjr op log --no-graph -n 1 -T 'id.short(12)')
$hunks" "$out"

  local before
  before=$(jjr op log --no-graph -n 1 -T 'id.short()')
  triad absorb --apply
  same "absorb --apply exit" 0 "$code"
  same "absorb --apply" "$hunks
absorbed 3 hunks into 2 commits
  $(change A): none -> none
  $(change B): none -> none
  $c: none -> none" "$out"
  same "A's f.txt" "f1 f2 f3 A fixed f4 f5 f6 A fixed f7 f8 f9 f10 f11 f12 A f13 f14" \
    "$(jjr file show -r A f.txt | paste -sd' ' -)"
  same "B's f.txt" "f1 f2 f3 A fixed f4 f5 f6 A fixed f7 f8 f9 B fixed f10 f11 f12 A f13 f14" \
    "$(jjr file show -r B f.txt | paste -sd' ' -)"
  same "what @ keeps" "M f.txt,A new.txt" "$(jjr diff --summary -r @ | paste -sd, -)"
  same "@'s f.txt changes" "-f1,+f1 fixed,-f12 A,+f12 A fixed" \
    "$(jjr diff --git -r @ f.txt | grep -E '^[-+][^-+]' | paste -sd, -)"
  same "operations after the apply" "absorb in triad" "$(ops_since "$before")"
  same "conflicted commits" "" "$(jjr log --no-graph -r 'conflicts()' -T 'change_id.short() ++ "\n"')"
}

test_dirs() {
  build dirs
  # The demo's design (fixtures/demo/README.md), with renames and copies paired as jj pairs
  # them.
  local want="added binary assets/icon.png
modified binary assets/logo.png
added text docs/design.md
deleted text docs/notes.md
added text invoice/cli.py
renamed text invoice/util.py => invoice/helpers.py
renamed text invoice/parser.py => invoice/io/parser.py
copied text invoice/totals.py => invoice/summary.py
modified text invoice/totals.py
deleted text legacy.txt
added undecodable names-bad-mark.txt
added text names-latin1.txt
files: 12"
  triad diff --inspect
  same "diff --inspect exit" "$EXIT_CONFLICTS" "$code"
  same "diff --inspect" "$want" "$out"
  triad diff --inspect --rev base
  same "diff --inspect --rev base" "$want" "$out"
  same "renames and copies jj names" \
    "R invoice/{util.py => helpers.py},R invoice/{ => io}/parser.py,C invoice/{totals.py => summary.py}" \
    "$(jjr diff --summary | grep '^[RC]' | paste -sd, -)"
  # jj's dir mode: two directories of the changed files, as `install --jj` sets it up.
  local got
  got=$(jjr diff --tool triad \
    --config "merge-tools.triad.program=\"$TRIAD\"" \
    --config 'merge-tools.triad.diff-args=["diff", "--inspect", "$left", "$right"]' \
    --config 'merge-tools.triad.diff-invocation-mode="dir"' \
    --config 'merge-tools.triad.diff-expected-exit-codes=[0, 1]' 2>&1) || fail "jj diff --tool failed"
  same "jj diff --tool" "$want" "$got"
}

scenarios=("$@")
[[ ${#scenarios[@]} -gt 0 ]] || scenarios=(stack sides history absorb dirs)
for current in "${scenarios[@]}"; do
  declare -F "test_$current" >/dev/null || { echo "error: unknown scenario $current" >&2; exit 2; }
  before=$failures
  "test_$current"
  [[ $failures -eq $before ]] && echo "ok   $current"
done
[[ $failures -eq 0 ]] || { echo "$failures check(s) failed"; exit 1; }
