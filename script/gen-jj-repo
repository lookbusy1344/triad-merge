#!/usr/bin/env bash
# gen-jj-repo — build a disposable jj repository set up to try one jj-enabled feature by
# hand. `jj git init` lays it out by jj's default. docs/test-repos.md describes each
# scenario's history and what to try in it; script/test-jj-repos checks triad against them.
#
# Scenarios:
#   stack    conflicts across a stack of commits, some inherited: `stack`, `resolve -r`
#   sides    a three-sided conflict in the working copy: the panes and the conflict badge
#   history  one file's versions across the operation log: `history`, `diff --op`
#   absorb   working-copy fixes over a stack of commits: `absorb`
#   dirs     the demo directories as a commit and the working copy: `diff`, `jj diff --tool`
#
# Identity, timestamps and change IDs are fixed, so every run gives the same commit and
# change IDs. The script ignores the user's jj config. Each scenario checks the state it built
# with jj and fails when jj disagrees.
#
# Usage: script/gen-jj-repo SCENARIO [dest]
#   dest  a directory that does not exist or is empty (default: a new temp directory)
set -euo pipefail

SCENARIOS="stack sides history absorb dirs"
ROOT=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=platform.sh
source "$ROOT/script/platform.sh"

usage() { sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p;}' "$0"; }

scenario=
dest=
for arg in "$@"; do
  case "$arg" in
    -h | --help) usage; exit 0 ;;
    -*) echo "error: unknown option $arg" >&2; exit 2 ;;
    *)
      if [[ -z "$scenario" ]]; then
        scenario=$arg
      elif [[ -z "$dest" ]]; then
        dest=$arg
      else
        echo "error: too many arguments" >&2
        exit 2
      fi
      ;;
  esac
done
if [[ -z "$scenario" ]]; then
  usage >&2
  exit 2
fi
if [[ " $SCENARIOS " != *" $scenario "* ]]; then
  echo "error: unknown scenario $scenario; one of: $SCENARIOS" >&2
  exit 2
fi

if [[ -z "$dest" ]]; then
  dest=$(mktemp -d "${TMPDIR:-/tmp}/triad-jj-$scenario.XXXXXX")
elif [[ -e "$dest" && -n "$(ls -A "$dest")" ]]; then
  echo "error: $dest is not empty" >&2
  exit 1
fi
mkdir -p "$dest"
dest=$(cd "$dest" && pwd)

# An isolated jj config: no user settings, signing or hooks leak in.
config=$(mktemp "${TMPDIR:-/tmp}/triad-jj-config.XXXXXX")
trap 'rm -f "$config"' EXIT
# Exiting from a signal trap runs the EXIT trap; dying from the signal does not.
readonly SIGNAL_EXIT_BASE=128
readonly SIGHUP_NUMBER=1 SIGINT_NUMBER=2 SIGTERM_NUMBER=15
trap 'exit $((SIGNAL_EXIT_BASE + SIGHUP_NUMBER))' HUP
trap 'exit $((SIGNAL_EXIT_BASE + SIGINT_NUMBER))' INT
trap 'exit $((SIGNAL_EXIT_BASE + SIGTERM_NUMBER))' TERM
cat >"$config" <<'EOF'
[user]
name = "triad Fixture"
email = "fixture@example.invalid"
[ui]
paginate = "never"
color = "never"
EOF
export JJ_CONFIG="$config"
export JJ_TIMESTAMP="2026-01-01T12:00:00+00:00"
export JJ_OP_TIMESTAMP="2026-01-01T12:00:00+00:00"
export JJ_OP_HOSTNAME="fixture"
export JJ_OP_USERNAME="fixture"

# jj reseeds its change-ID generator from this on every run; a new seed per call keeps the
# IDs fixed across runs and distinct within one.
seed=0
jj_() { seed=$((seed + 1)); JJ_RANDOMNESS_SEED=$seed jj --quiet -R "$dest" "$@"; }
# Write FILE with one line per further argument.
put() { local file=$1; shift; printf '%s\n' "$@" >"$dest/$file"; }
# The lines PREFIX1 to PREFIXN, one per argument slot.
seq_lines() { local prefix=$1 n=$2 i; for ((i = 1; i <= n; i++)); do echo "$prefix$i"; done; }
# FILE with line N replaced by TEXT.
set_line() { local file=$1 n=$2 text=$3; awk -v n="$n" -v t="$text" 'NR == n { $0 = t } 1' "$dest/$file" >"$dest/$file.new" && mv "$dest/$file.new" "$dest/$file"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
# The paths jj lists as conflicted in REV, one per line, sorted.
# `jj resolve --list` exits 2 when it finds none.
conflicts_in() { { (cd "$dest" && jj --quiet resolve --list -r "$1" 2>/dev/null) || true; } | slash_paths | awk '{print $1}' | sort; }
expect_conflicts() {
  local rev=$1 want=$2 got
  got=$(conflicts_in "$rev")
  [[ "$got" == "$want" ]] || fail "$rev: expected conflicts [$want], got [$got]"
}

# jj's default layout: no layout flag.
JJ_RANDOMNESS_SEED=0 jj --quiet git init "$dest"

# Conflicts across a stack: stack-1 conflicts with left in a.txt at a3; stack-2 inherits it
# and adds its own conflict in the same file at a7; stack-3 inherits both and adds its own
# conflict in b.txt; @ inherits all three.
gen_stack() {
  seq_lines a 8 >"$dest/a.txt"
  seq_lines b 8 >"$dest/b.txt"
  seq_lines c 4 >"$dest/c.txt"
  jj_ commit -m "base: three files"
  jj_ bookmark create base -r @-

  set_line a.txt 3 "a3 left"
  set_line a.txt 7 "a7 left"
  set_line b.txt 5 "b5 left"
  jj_ commit -m "left: change a3, a7 and b5"
  jj_ bookmark create left -r @-

  jj_ new base
  set_line a.txt 3 "a3 stack"
  jj_ commit -m "stack 1: change a3"
  jj_ bookmark create stack-1 -r @-
  set_line c.txt 2 "c2 stack"
  set_line a.txt 7 "a7 stack"
  jj_ commit -m "stack 2: change c2 and a7"
  jj_ bookmark create stack-2 -r @-
  set_line b.txt 5 "b5 stack"
  jj_ commit -m "stack 3: change b5"
  jj_ bookmark create stack-3 -r @-

  jj_ rebase -s stack-1 -d left

  expect_conflicts stack-1 "a.txt"
  expect_conflicts stack-2 "a.txt"
  expect_conflicts stack-3 $'a.txt\nb.txt'
  expect_conflicts @ $'a.txt\nb.txt'
}

# A three-sided conflict: s2 differs on all three sides; s7 on two, the third keeps base.
gen_sides() {
  seq_lines s 9 >"$dest/s.txt"
  jj_ commit -m "base: one file"
  jj_ bookmark create base -r @-
  local side
  for side in one two three; do
    jj_ new base
    set_line s.txt 2 "s2 $side"
    local changed="s2"
    if [[ "$side" != three ]]; then
      set_line s.txt 7 "s7 $side"
      changed="s2 and s7"
    fi
    jj_ commit -m "$side: change $changed"
    jj_ bookmark create "$side" -r @-
  done
  jj_ new one two three -m "merge one, two and three"

  expect_conflicts @ "s.txt"
  local listed
  listed=$(cd "$dest" && jj --quiet resolve --list)
  [[ "$listed" == *"3-sided conflict"* ]] || fail "expected a 3-sided conflict, jj lists: $listed"
}

# One file across the operation log: v1 committed; v2 and v3 snapshotted in the next commit;
# deleted; v4 committed; then @ moves to a sibling that writes another text, and last to a
# merge where notes.txt conflicts. `jj status` snapshots each step.
gen_history() {
  put notes.txt "notes" "v1"
  jj_ commit -m "notes v1"
  jj_ bookmark create one -r @-
  put notes.txt "notes" "v2"
  jj_ status >/dev/null
  put notes.txt "notes" "v3"
  jj_ status >/dev/null
  rm "$dest/notes.txt"
  jj_ status >/dev/null
  put notes.txt "notes" "v4"
  jj_ commit -m "notes v4"
  jj_ bookmark create four -r @-
  jj_ new one
  put notes.txt "notes" "other"
  jj_ commit -m "notes other"
  jj_ bookmark create other -r @-
  jj_ new four other -m "merge four and other"

  expect_conflicts @ "notes.txt"
}

# A stack over an immutable base, and fixes in the working copy:
#   f1  base wrote it, and base is immutable        -> stays
#   f3  A wrote it                                  -> A
#   f6  A wrote it                                  -> A
#   f9  B wrote it                                  -> B
#   f12 A wrote it; C changed f13 next to it        -> stays: would conflict in A
#   new.txt, a new file                             -> stays
gen_absorb() {
  seq_lines f 14 >"$dest/f.txt"
  jj_ commit -m "base: one file"
  jj_ bookmark create base -r @-
  jj_ config set --repo 'revset-aliases."immutable_heads()"' base

  set_line f.txt 3 "f3 A"
  set_line f.txt 6 "f6 A"
  set_line f.txt 12 "f12 A"
  jj_ commit -m "A: change f3, f6 and f12"
  jj_ bookmark create A -r @-
  set_line f.txt 9 "f9 B"
  jj_ commit -m "B: change f9"
  jj_ bookmark create B -r @-
  set_line f.txt 13 "f13 C"
  jj_ commit -m "C: change f13"
  jj_ bookmark create C -r @-

  set_line f.txt 1 "f1 fixed"
  set_line f.txt 3 "f3 A fixed"
  set_line f.txt 6 "f6 A fixed"
  set_line f.txt 9 "f9 B fixed"
  set_line f.txt 12 "f12 A fixed"
  put new.txt "new"
  jj_ status >/dev/null

  local mutable
  mutable=$(cd "$dest" && jj --quiet log --no-graph -r 'mutable() & ::@-' -T 'description.first_line() ++ "\n"' | sort | paste -sd, -)
  [[ "$mutable" == "A: change f3, f6 and f12,B: change f9,C: change f13" ]] ||
    fail "expected A, B and C mutable and base immutable, got: $mutable"
}

# fixtures/demo/dirs/left committed as `base`; the working copy then holds right instead.
gen_dirs() {
  local demo="$ROOT/fixtures/demo/dirs"
  cp -R "$demo/left/." "$dest/"
  jj_ commit -m "base: the demo's left directory"
  jj_ bookmark create base -r @-
  find "$dest" -mindepth 1 -maxdepth 1 ! -name .jj ! -name .git -exec rm -rf {} +
  cp -R "$demo/right/." "$dest/"
  jj_ status >/dev/null

  local summary
  summary=$(cd "$dest" && jj --quiet diff --summary | slash_paths | paste -sd, -)
  [[ "$summary" == "A assets/icon.png,M assets/logo.png,A docs/design.md,D docs/notes.md,A invoice/cli.py,R invoice/{util.py => helpers.py},R invoice/{ => io}/parser.py,C invoice/{totals.py => summary.py},M invoice/totals.py,D legacy.txt,A names-bad-mark.txt,A names-latin1.txt" ]] ||
    fail "expected two renames and a copy among twelve changes, jj lists: $summary"
}

"gen_$scenario"
echo "$dest"
