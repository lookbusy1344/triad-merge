#!/usr/bin/env bash
# Runs a command in the Linux test machine, on a copy of this checkout. OrbStack or Docker
# provides it. The copy and the build sit on volumes: a Mac bind mount is slow, and file
# watchers get no events through it.
#
#   script/linux/run image                 build the image; rerun after a new stable Rust
#   script/linux/run cargo nextest run ... any command, in the copy
#
# TRIAD_LINUX_ARCH picks the machine's architecture: x86_64 (the default) or aarch64. Each has
# its own image and volumes.
set -euo pipefail

readonly ARCH=${TRIAD_LINUX_ARCH:-x86_64}
case $ARCH in
    x86_64) readonly PLATFORM=linux/amd64 ;;
    aarch64) readonly PLATFORM=linux/arm64 ;;
    *) echo "script/linux/run: TRIAD_LINUX_ARCH must be x86_64 or aarch64, not $ARCH" >&2; exit 2 ;;
esac
readonly IMAGE=triad-linux-$ARCH
readonly STABLE_MANIFEST_DIGEST=https://static.rust-lang.org/dist/channel-rust-stable.toml.sha256
root=$(cd "$(dirname "$0")/../.." && pwd)
readonly root
mkdir -p "$root/target/linux"

if [[ ${1:-} == image ]]; then
    stable=$(curl -fsSL "$STABLE_MANIFEST_DIGEST")
    exec docker build --platform "$PLATFORM" -t "$IMAGE" \
        --build-arg "RUST_STABLE=${stable%% *}" "$root/script/linux"
fi

# The copy has no .jj or .git, so the host names the commit of a package build.
if [[ ${1:-} == script/package ]]; then
    eval "$(cd "$root" && script/build-id)"
fi

exec docker run --rm --init --platform "$PLATFORM" \
    -e TRIAD_COMMIT \
    -e TRIAD_CHANGE \
    -v "$root:/host:ro" \
    -v "$root/target/linux:/out" \
    -v "$IMAGE-src":/work \
    -v "$IMAGE-target":/target \
    -v "$IMAGE-registry":/opt/cargo/registry \
    -e CARGO_TARGET_DIR=/target \
    -e CARGO_TERM_COLOR=never \
    -w /work \
    "$IMAGE" bash -c '
        rsync -a --delete --exclude /target --exclude /.jj --exclude /.git /host/ /work/
        exec "$@"' bash "$@"
