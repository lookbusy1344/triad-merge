#!/usr/bin/env bash
# Builds the packages of one target (spec §2.1) into /out/dist. Linux runs in the Linux test
# machine, whose glibc is the oldest triad supports:
#
#   script/linux/run script/package x86_64-unknown-linux-gnu
set -euo pipefail

readonly target=${1:?usage: script/package <target>}
readonly linux=x86_64-unknown-linux-gnu
readonly bin=triad-merge
readonly dist=/out/dist
# Not on every desktop. libxcb stays out: the system's must match its graphics drivers.
readonly bundled=(libxkbcommon.so.0 libxkbcommon-x11.so.0 libxcb-xkb.so.1)
readonly lib_dir=/lib/x86_64-linux-gnu

[[ $target == "$linux" ]] || { echo "script/package: no packaging for $target yet" >&2; exit 2; }

version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)
readonly name=$bin-$version-$target
stage=$(mktemp -d)

cargo build --release --locked -p "$bin"
mkdir -p "$dist"
rm -f "$dist/$bin"-*

stripped=$stage/$bin
install -m 755 "${CARGO_TARGET_DIR:-target}/release/$bin" "$stripped"
strip "$stripped"

# Copies the binary and the bundled libraries to $1/$2 and $1/$3. The binary finds them by the
# rpath $4, so that the programs triad starts see the system's libraries.
bundle() {
    local root=$1 bin_dir=$2 libs=$3 rpath=$4
    mkdir -p "$root/$bin_dir" "$root/$libs"
    install -m 755 "$stripped" "$root/$bin_dir/$bin"
    for lib in "${bundled[@]}"; do
        cp -L "$lib_dir/$lib" "$root/$libs/"
    done
    patchelf --set-rpath "$rpath" "$root/$bin_dir/$bin"
    patchelf --set-rpath '$ORIGIN' "$root/$libs/"*.so*
    cp packaging/linux/"$bin".desktop "$root/"
    cp images/triad-icon.svg "$root/$bin.svg"
    cp vendor/gpui-base/LICENSE-APACHE "$root/LICENSE-gpui-base"
}

bundle "$stage/$name" . lib '$ORIGIN/lib'
cp README.md "$stage/$name/"
tar -C "$stage" -czf "$dist/$name.tar.gz" "$name"

app_dir=$stage/AppDir
bundle "$app_dir" usr/bin usr/lib '$ORIGIN/../lib'
ln -s "$bin".svg "$app_dir/.DirIcon"
ln -s "usr/bin/$bin" "$app_dir/AppRun"
ARCH=x86_64 /opt/appimage/squashfs-root/AppRun --no-appstream \
    --runtime-file /opt/appimage/runtime "$app_dir" "$dist/$name.AppImage"

(cd "$dist" && sha256sum "$name".* > "$name.sha256")
ls -l "$dist"
